# Copy this file to .env and fill in your real keys. .env is gitignored.

# Claude API key from https://console.anthropic.com (deliberately NOT named ANTHROPIC_API_KEY,
# because Claude's own tools reserve that name)
PIPELINE_ANTHROPIC_KEY=sk-ant-...

# JSearch key from OpenWeb Ninja (https://www.openwebninja.com), sent as the X-API-Key header
JSEARCH_API_KEY=

# Local Business Data (apprenticeship outreach): subscribe at
# https://app.openwebninja.com/api/local-business-data/overview. Leave empty if your JSearch key works for it.
LOCAL_BUSINESS_API_KEY=
